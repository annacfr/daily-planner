{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "School schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timezone", "lesson_times", "weekdays"],
  "properties": {
    "schema_version": {"const": 1},
    "timezone": {"const": "Europe/Moscow"},
    "lesson_times": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["number", "start", "end"],
        "properties": {
          "number": {"type": "integer", "minimum": 1, "maximum": 8},
          "start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "end": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
        }
      }
    },
    "weekdays": {
      "type": "object", "additionalProperties": false,
      "required": ["monday", "tuesday", "wednesday", "thursday", "friday"],
      "properties": {
        "monday": {"$ref": "#/$defs/day"},
        "tuesday": {"$ref": "#/$defs/day"},
        "wednesday": {"$ref": "#/$defs/day"},
        "thursday": {"$ref": "#/$defs/day"},
        "friday": {"$ref": "#/$defs/day"}
      }
    }
  },
  "$defs": {
    "day": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["number", "subject"],
        "properties": {
          "number": {"type": "integer", "minimum": 1, "maximum": 8},
          "subject": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    }
  }
}
